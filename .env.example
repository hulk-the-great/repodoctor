# RepoDoctor provider options: mock, gemini, ollama, openai
# Use mock for deterministic local demo.
# Use gemini when your laptop cannot run a local model and you need a free cloud API.

REPO_DOCTOR_LLM_PROVIDER=gemini

# Gemini free cloud API option
# Get a key from Google AI Studio. Never commit a real key to GitHub.
GEMINI_API_KEY=your_gemini_api_key_here
REPO_DOCTOR_GEMINI_MODEL=gemini-2.5-flash-lite

# Optional: stronger Gemini model, still cloud-based
# REPO_DOCTOR_GEMINI_MODEL=gemini-2.5-flash

# Optional local LLM option
REPO_DOCTOR_OLLAMA_MODEL=qwen2.5-coder:7b
REPO_DOCTOR_OLLAMA_URL=http://localhost:11434

# Optional paid cloud LLM option
OPENAI_API_KEY=your_openai_api_key_here
REPO_DOCTOR_OPENAI_MODEL=gpt-5.5
